# Backend service URL (used by frontend to proxy chat and stats requests)
# Local development:  BACKEND_URL=http://localhost:8001
# Docker Compose:     BACKEND_URL=http://backend:8001
BACKEND_URL=http://backend:8001

# Google Gemini API key (required for Gemini models in the backend)
GOOGLE_API_KEY=your_google_api_key_here

# Path to the jobs SQLite database produced by week_1
# Local development: set to the actual path on your machine
# Docker Compose:    leave as /app/data/jobs_database.db (mounted via volume)
DB_PATH=/app/data/jobs_database.db

# LLM model used by the backend for chat responses (default: gemini-2.5-flash-lite)
CHAT_MODEL=gemini-2.5-flash



